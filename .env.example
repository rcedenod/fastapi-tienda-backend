# Base de datos
# Formato: mysql+pymysql://usuario:password@host:puerto/nombre_db
DATABASE_URI=mysql+pymysql://root:your_password@localhost:3306/cms_db

# Bcrypt (puede ser cualquier valor, actualmente no se utiliza en el código)
BCRYPT_SALT=any_value

# JWT - Clave secreta para firmar tokens. Debe ser larga y aleatoria.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_KEY=your_jwt_secret_key_here

# Cloudinary - Subida de archivos a la nube
# Obtener en: https://console.cloudinary.com/app/settings/api-keys
# Formato: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
